NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only: production webhook URL from n8n. Never prefix this with NEXT_PUBLIC_.
N8N_WEBHOOK_URL=https://your-n8n-host/webhook/your-path

# Optional until Header Auth is enabled on the n8n Webhook node.
N8N_WEBHOOK_AUTH_TOKEN=

# Server-only webhook for AI distance estimates.
N8N_ESTIMATIVA_WEBHOOK_URL=
N8N_ESTIMATIVA_WEBHOOK_AUTH_TOKEN=
